# Copy to .env.development.local (git-ignored). Used by `npm run dev` and overrides .env.local.
# Point this at a FRESH Supabase project, never the production one.
# Supabase dashboard: Project Settings -> API (url, anon, service_role) and Database (connection string).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

NEXT_PUBLIC_URL=http://localhost:3000

# Sage (optional: only needed to test the coach)
ANTHROPIC_API_KEY=

# Keep these EMPTY locally so test actions cannot send real email or take real payments.
SUMMIT_GMAIL_USER=
SUMMIT_GMAIL_APP_PASSWORD=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
MAILERLITE_API_KEY=
