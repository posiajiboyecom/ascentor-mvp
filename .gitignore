# --- Environment variables (NEVER commit these) ---
# Catch-all: any .env variant (e.g. .env.staging, .env.backup) stays out of Git; only the template is tracked.
.env*
!.env.example
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.prod

# --- Next.js ---
/.next/
/out/
/build

# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS ---
.DS_Store
Thumbs.db

# --- Misc ---
*.zip
.gstack/

# --- Build / tooling artifacts (were committed by mistake) ---
.trigger/
supabase/.temp/
*.tsbuildinfo
.vercel

# Prisma generated client
/generated/prisma

.vercel

# --- Secrets & local-only config ---
*.pem
*.key
*.p12
*.keystore
!android/**/debug.keystore
service-account*.json
.claude/settings.local.json
