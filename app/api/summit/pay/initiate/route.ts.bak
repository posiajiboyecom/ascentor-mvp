import { NextRequest, NextResponse } from 'next/server';
import { supabaseAdmin } from '@/lib/supabase/admin';

export async function POST(req: NextRequest) {
  try {
    const { registrationId } = await req.json();

    if (!registrationId) {
      return NextResponse.json({ error: 'Registration ID is required' }, { status: 400 });
    }

    const { data: registration, error } = await supabaseAdmin
      .from('summit_registrations')
      .select('id, full_name, email, phone')
      .eq('id', registrationId)
      .single();

    if (error || !registration) {
      console.error('[summit/pay/initiate] Registration lookup error:', error?.message);
      return NextResponse.json({ error: 'Registration not found' }, { status: 404 });
    }

    const tx_ref = `summit-${registration.id}-${Date.now()}`;
    const amount = Number(process.env.SUMMIT_TICKET_PRICE_NGN) || 0;

    if (amount <= 0) {
      return NextResponse.json({ error: 'Ticket price is not configured' }, { status: 500 });
    }

    const { error: updateError } = await supabaseAdmin
      .from('summit_registrations')
      .update({ payment_reference: tx_ref })
      .eq('id', registration.id);

    if (updateError) {
      console.error('[summit/pay/initiate] Update error:', updateError.message);
      return NextResponse.json({ error: 'Could not prepare payment' }, { status: 500 });
    }

    return NextResponse.json({
      tx_ref,
      amount,
      currency: 'NGN',
      public_key: process.env.NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY || '',
      customer: {
        email: registration.email,
        name: registration.full_name,
        phone_number: registration.phone || '',
      },
    });
  } catch (err: any) {
    console.error('[summit/pay/initiate] Unexpected error:', err.message);
    return NextResponse.json({ error: 'An unexpected error occurred' }, { status: 500 });
  }
}
