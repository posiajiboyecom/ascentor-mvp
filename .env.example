# Copy to .env.local and fill in. Never commit real values.
# Full description of every variable: README.md, section 10.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Launch switch ---
# "true" opens /login and /signup. Leave unset to keep the production gate.
NEXT_PUBLIC_PLATFORM_OPEN=
NEXT_PUBLIC_URL=http://localhost:3000

# --- AI ---
ANTHROPIC_API_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
SUMMIT_TICKET_PRICE_ONSITE_NGN=
SUMMIT_TICKET_PRICE_VIRTUAL_NGN=

# --- Secrets for scheduled and server-to-server routes ---
CRON_SECRET=
# Optional: signs tracked links in campaign emails (Admin → Email). Falls back to a value derived from the service role key.
EMAIL_TRACKING_SECRET=
INTERNAL_API_SECRET=
PUSH_INTERNAL_SECRET=
OTP_HMAC_SECRET=

# --- Auth hardening (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_MFA_REQUIRED=

# --- Mail ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# One real mailbox (a.samuel@joinascentor.com) is the SMTP login, so it is the only address the server lets us send as. Every address
# below defaults to it. contact@ and hello@ are Hostinger aliases: do not point anything at them until a test mail from outside
# arrives (see docs/mail-addresses.md). Use Reply-To, not From, for an alias.
MAIL_FROM=Ascentor <a.samuel@joinascentor.com>
MAIL_REPLY_TO=a.samuel@joinascentor.com
ADMIN_NOTIFY_EMAIL=a.samuel@joinascentor.com
SUPPORT_EMAIL=a.samuel@joinascentor.com
NEXT_PUBLIC_SUPPORT_EMAIL=a.samuel@joinascentor.com
# Set to true only after contact@joinascentor.com is proven to receive mail. Until then mail addressed to it goes to ADMIN_NOTIFY_EMAIL.
MAIL_ALLOW_ALIASES=
# Older names, still read when the ones above are empty: EMAIL_FROM, ADMIN_EMAIL, SUMMIT_ADMIN_EMAIL, FOUNDER_EMAIL, ADMIN_ALERT_EMAIL.
# Every email to a Summit registrant (confirmation, ticket, resend, reminders, receipts) is sent from this address. Default if empty:
# The Elevation Summit <summit@joinascentor.com>. Keep it on joinascentor.com (SPF/DKIM/DMARC). Team alerts keep using MAIL_FROM.
SUMMIT_MAIL_FROM=
SUMMIT_ADMIN_EMAIL=
MAILERLITE_API_KEY=

# --- Google sign-in (see docs/google-oauth-custom.md) ---
# GOOGLE_AUTH_MODE: "supabase" (default, the old redirect flow) or "custom" (our own flow, so Google shows joinascentor.com instead of
# the Supabase project address). Leave it unset until the two values below are in place and tested.
GOOGLE_AUTH_MODE=supabase
# Server only. Copy both from the same Google Cloud OAuth 2.0 Web client that is already enabled in Supabase (Auth > Providers > Google).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Local tooling only (never on Vercel) ---
DATABASE_URL=

# Audio calls (Circle weekly call, mentor sessions). Create a key at https://dashboard.daily.co/developers
DAILY_API_KEY=
# Optional: members interested before a group is suggested to admins (default 20)
GROUP_SUGGESTION_MIN=20

# --- Plan prices (NGN, whole naira, monthly) ---
# The ONE place plan prices are set (read by lib/plans-config.ts). Checkout, settlement, the Plan screen and the
# payment result page all use these. Annual billing is 12 months less 20%. Leader is free.
# A bad value (not a positive whole number) stops payments with an error instead of charging a wrong amount.
# Set them in Vercel for Production AND Preview, then REDEPLOY: variables are read when the server starts.
PLAN_SEEKER_PRICE_NGN=15000
PLAN_BUILDER_PRICE_NGN=25000
PLAN_LEADER_PRICE_NGN=40000

# --- Public sign-up switch ---
# true  = /signup and /login are open to the public. Anything else = the "coming soon" gate. Single switch, set back to
# false (and redeploy) to close signup again. Local `npm run dev` is always open regardless.
NEXT_PUBLIC_PLATFORM_OPEN=false

# --- Signed shop download links ---
# Secret used to sign emailed PDF download links (and partner invite tokens). Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates download links already emailed.
APP_SECRET_KEY=
