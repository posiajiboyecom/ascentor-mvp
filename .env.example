# Copy to .env.local and fill in. Never commit real values.
# Full description of every variable: README.md, section 10.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Launch switch ---
# "true" opens /login and /signup. Leave unset to keep the production gate.
NEXT_PUBLIC_PLATFORM_OPEN=
NEXT_PUBLIC_URL=http://localhost:3000

# --- AI ---
ANTHROPIC_API_KEY=

# --- Payments ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
SUMMIT_TICKET_PRICE_ONSITE_NGN=
SUMMIT_TICKET_PRICE_VIRTUAL_NGN=

# --- Secrets for scheduled and server-to-server routes ---
CRON_SECRET=
INTERNAL_API_SECRET=
PUSH_INTERNAL_SECRET=
OTP_HMAC_SECRET=

# --- Auth hardening (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ADMIN_MFA_REQUIRED=

# --- Mail ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Ascentor <hello@joinascentor.com>
SUMMIT_MAIL_FROM=Ascentor Summit <hello@joinascentor.com>
ADMIN_EMAIL=
SUMMIT_ADMIN_EMAIL=
MAILERLITE_API_KEY=

# --- Local tooling only (never on Vercel) ---
DATABASE_URL=

# Audio calls (Circle weekly call, mentor sessions). Create a key at https://dashboard.daily.co/developers
DAILY_API_KEY=
# Optional: members interested before a group is suggested to admins (default 20)
GROUP_SUGGESTION_MIN=20

# --- Plan prices (NGN, whole naira, monthly) ---
# The ONE place plan prices are set (read by lib/plans-config.ts). Checkout, settlement, the Plan screen and the
# payment result page all use these. Annual billing is 12 months less 20%. Leader is free.
# A bad value (not a positive whole number) stops payments with an error instead of charging a wrong amount.
# Set them in Vercel for Production AND Preview, then REDEPLOY: variables are read when the server starts.
PLAN_SEEKER_PRICE_NGN=15000
PLAN_BUILDER_PRICE_NGN=25000
PLAN_LEADER_PRICE_NGN=40000

# --- Public sign-up switch ---
# true  = /signup and /login are open to the public. Anything else = the "coming soon" gate. Single switch, set back to
# false (and redeploy) to close signup again. Local `npm run dev` is always open regardless.
NEXT_PUBLIC_PLATFORM_OPEN=false

# --- Signed shop download links ---
# Secret used to sign emailed PDF download links (and partner invite tokens). Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates download links already emailed.
APP_SECRET_KEY=
